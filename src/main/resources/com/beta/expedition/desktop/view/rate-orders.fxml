<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.beta.expedition.desktop.controller.RateOrdersController" spacing="16">
    <Label fx:id="titleLabel" styleClass="page-title"/>
    <Label fx:id="hintLabel" styleClass="muted-text" wrapText="true"/>
    <FlowPane hgap="8" vgap="8" alignment="CENTER_LEFT">
        <Button fx:id="rateButton" text="Оценить" styleClass="button-primary" onAction="#onRate"/>
        <Button fx:id="refreshButton" text="Обновить" styleClass="button-secondary" onAction="#onRefresh"/>
        <ProgressIndicator fx:id="busyIndicator" prefWidth="22" prefHeight="22"/>
    </FlowPane>
    <TableView minHeight="220" fx:id="ordersTable" VBox.vgrow="ALWAYS">
        <placeholder>
            <Label text="Нет услуг, ожидающих оценки" styleClass="muted-text"/>
        </placeholder>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="numberColumn" text="Заявка" minWidth="70" prefWidth="80"/>
            <TableColumn fx:id="cargoColumn" text="Груз" prefWidth="240"/>
            <TableColumn fx:id="originColumn" text="Откуда" prefWidth="130"/>
            <TableColumn fx:id="destinationColumn" text="Куда" prefWidth="130"/>
            <TableColumn fx:id="createdColumn" text="Создана" prefWidth="130"/>
        </columns>
    </TableView>
</VBox>
