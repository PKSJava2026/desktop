<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.beta.expedition.desktop.controller.CooperationController" spacing="16">
    <Label fx:id="titleLabel" styleClass="page-title"/>
    <FlowPane hgap="8" vgap="8" alignment="CENTER_LEFT">
        <Button fx:id="createButton" text="Создать заявку" styleClass="button-primary" onAction="#onCreate"/>
        <Button fx:id="cancelButton" text="Отозвать заявку" styleClass="button-danger" onAction="#onCancelRequest"/>
        <Button fx:id="contractButton" text="Заключить договор" styleClass="button-primary"
                onAction="#onCreateContract"/>
        <Button text="Обновить" styleClass="button-secondary" onAction="#onRefresh"/>
        <ProgressIndicator fx:id="busyIndicator" prefWidth="22" prefHeight="22"/>
    </FlowPane>
    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <TableView minHeight="220" fx:id="requestsTable" HBox.hgrow="ALWAYS">
            <placeholder>
                <Label text="Заявок о сотрудничестве нет" styleClass="muted-text"/>
            </placeholder>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="idColumn" text="№" minWidth="50" prefWidth="55"/>
                <TableColumn fx:id="carrierColumn" text="Перевозчик" prefWidth="120"/>
                <TableColumn fx:id="vehicleColumn" text="Транспорт" prefWidth="180"/>
                <TableColumn fx:id="descriptionColumn" text="О себе" prefWidth="220"/>
                <TableColumn fx:id="statusColumn" text="Статус" prefWidth="110"/>
                <TableColumn fx:id="createdColumn" text="Создана" prefWidth="130"/>
            </columns>
        </TableView>
        <VBox styleClass="card" prefWidth="270" minWidth="240" maxWidth="300" spacing="16">
            <Label text="Сведения о заявке" styleClass="section-title"/>
            <Label fx:id="detailsHint" text="Выберите заявку в таблице" styleClass="muted-text" wrapText="true"/>
            <GridPane fx:id="detailsGrid" hgap="8" vgap="8">
                <columnConstraints>
                    <ColumnConstraints minWidth="90" prefWidth="100"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>
                <Label text="Номер" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <Label wrapText="true" fx:id="detailsNumber" styleClass="value-label" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label text="Статус" styleClass="field-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Label wrapText="true" fx:id="detailsStatus" styleClass="status-badge" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                <Label fx:id="detailsCarrierCaption" text="Перевозчик" styleClass="field-label"
                       GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <Label fx:id="detailsCarrier" styleClass="value-label" wrapText="true"
                       GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                <Label text="Транспорт" styleClass="field-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <Label fx:id="detailsVehicle" styleClass="value-label" wrapText="true"
                       GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                <Label text="О себе" styleClass="field-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <Label fx:id="detailsDescription" styleClass="value-label" wrapText="true"
                       GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                <Label text="Создана" styleClass="field-label" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                <Label wrapText="true" fx:id="detailsCreated" styleClass="value-label" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
            </GridPane>
        </VBox>
    </HBox>
    <Label fx:id="countLabel" styleClass="muted-text"/>
</VBox>
