<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.beta.expedition.desktop.controller.ContractFormController"
      spacing="8" prefWidth="480" styleClass="form-box">
    <VBox fx:id="offerBox" spacing="8">
        <Label fx:id="counterpartyCaption" styleClass="field-label"/>
        <ComboBox fx:id="counterpartyBox" promptText="Выберите из списка" maxWidth="Infinity"/>
        <Label text="Заявка на перевозку" styleClass="field-label"/>
        <ComboBox fx:id="orderBox" promptText="Выберите заявку" maxWidth="Infinity"/>
    </VBox>
    <Label fx:id="amendHint" text="Текущие значения подставлены. Измените нужные: вторая сторона должна согласиться."
           styleClass="muted-text" wrapText="true"/>
    <Label text="Цена, руб." styleClass="field-label"/>
    <TextField fx:id="priceField" promptText="Например, 45000.50"/>
    <Label text="Условия" styleClass="field-label"/>
    <TextArea fx:id="termsField" promptText="Необязательно" prefRowCount="3" wrapText="true"/>
    <HBox spacing="16">
        <VBox spacing="8">
            <Label text="Дата начала" styleClass="field-label"/>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <DatePicker fx:id="startPicker" promptText="Необязательно" prefWidth="170"/>
                <Button text="×" styleClass="button-link" onAction="#onClearStart"/>
            </HBox>
        </VBox>
        <VBox spacing="8">
            <Label text="Дата окончания" styleClass="field-label"/>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <DatePicker fx:id="endPicker" promptText="Необязательно" prefWidth="170"/>
                <Button text="×" styleClass="button-link" onAction="#onClearEnd"/>
            </HBox>
        </VBox>
    </HBox>
    <Label fx:id="errorLabel" styleClass="error-text" wrapText="true" minHeight="-Infinity"/>
</VBox>
