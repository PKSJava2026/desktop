<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.beta.expedition.desktop.controller.NotificationsController" spacing="14">
    <Label text="Уведомления" styleClass="page-title"/>
    <FlowPane hgap="8" vgap="8" alignment="CENTER_LEFT">
        <Button fx:id="markReadButton" text="Отметить прочитанным" styleClass="button-primary"
                onAction="#onMarkRead"/>
        <Button fx:id="markAllButton" text="Прочитать все" styleClass="button-secondary" onAction="#onMarkAll"/>
        <Button fx:id="refreshButton" text="Обновить" styleClass="button-secondary" onAction="#onRefresh"/>
        <Label fx:id="counterLabel" styleClass="muted-text"/>
        <ProgressIndicator fx:id="busyIndicator" prefWidth="22" prefHeight="22"/>
    </FlowPane>
    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <TableView fx:id="notificationsTable" HBox.hgrow="ALWAYS">
            <placeholder>
                <Label text="Уведомлений пока нет" styleClass="muted-text"/>
            </placeholder>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="dateColumn" text="Дата" minWidth="120" prefWidth="130"/>
                <TableColumn fx:id="messageColumn" text="Сообщение" prefWidth="320"/>
                <TableColumn fx:id="stateColumn" text="Статус" minWidth="90" prefWidth="100"/>
            </columns>
        </TableView>
        <VBox styleClass="card" prefWidth="290" minWidth="250" maxWidth="320" spacing="12">
            <Label text="Сообщение" styleClass="section-title"/>
            <Label fx:id="detailsHint" text="Выберите уведомление в таблице" styleClass="muted-text"
                   wrapText="true"/>
            <GridPane fx:id="detailsGrid" hgap="10" vgap="8">
                <columnConstraints>
                    <ColumnConstraints minWidth="70" prefWidth="80"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>
                <Label text="Дата" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <Label fx:id="detailsDate" styleClass="value-label" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label text="Статус" styleClass="field-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Label fx:id="detailsState" styleClass="status-badge" GridPane.rowIndex="1"
                       GridPane.columnIndex="1"/>
                <Label text="Текст" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <Label fx:id="detailsMessage" styleClass="value-label" wrapText="true"
                       GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            </GridPane>
        </VBox>
    </HBox>
</VBox>
