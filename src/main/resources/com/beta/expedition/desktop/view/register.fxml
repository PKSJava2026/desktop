<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.beta.expedition.desktop.controller.RegisterController" styleClass="auth-pane">
    <VBox styleClass="card" spacing="8" maxWidth="400" maxHeight="-Infinity">
        <Label text="Регистрация" styleClass="page-title"/>
        <Label text="Никнейм" styleClass="field-label"/>
        <TextField fx:id="nicknameField" promptText="От 3 до 30 символов"/>
        <Label text="Email" styleClass="field-label"/>
        <TextField fx:id="emailField" promptText="name@example.com"/>
        <Label text="Пароль" styleClass="field-label"/>
        <PasswordField fx:id="passwordField" promptText="Не короче 6 символов"/>
        <Label text="Подтверждение пароля" styleClass="field-label"/>
        <PasswordField fx:id="confirmField" promptText="Повторите пароль"/>
        <Label text="Роль" styleClass="field-label"/>
        <ComboBox fx:id="roleBox" maxWidth="Infinity"/>
        <Label fx:id="errorLabel" styleClass="error-text" wrapText="true"/>
        <HBox spacing="16" alignment="CENTER_LEFT">
            <Button fx:id="registerButton" text="Зарегистрироваться" defaultButton="true" onAction="#onRegister"
                    styleClass="button-primary"/>
            <ProgressIndicator fx:id="busyIndicator" prefWidth="22" prefHeight="22"/>
        </HBox>
        <Button text="Уже есть аккаунт? Войти" onAction="#openLogin" styleClass="button-link"/>
    </VBox>
</StackPane>
