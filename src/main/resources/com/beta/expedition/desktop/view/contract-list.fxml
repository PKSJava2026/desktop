<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.beta.expedition.desktop.controller.ContractListController" spacing="16">
    <FlowPane hgap="8" vgap="8" alignment="CENTER_LEFT">
        <Button fx:id="offerButton" text="Предложить договор" styleClass="button-primary" onAction="#onOffer"/>
        <Button fx:id="acceptButton" text="Подтвердить" styleClass="button-primary" onAction="#onAccept"/>
        <Button fx:id="rejectButton" text="Отклонить" styleClass="button-danger" onAction="#onReject"/>
        <Button fx:id="amendButton" text="Изменить условия" styleClass="button-secondary" onAction="#onAmend"/>
        <Button fx:id="terminateButton" text="Расторгнуть" styleClass="button-danger" onAction="#onTerminate"/>
        <Button text="Обновить" styleClass="button-secondary" onAction="#onRefresh"/>
        <ProgressIndicator fx:id="busyIndicator" prefWidth="22" prefHeight="22"/>
        <Label fx:id="countLabel" styleClass="muted-text"/>
    </FlowPane>
    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <TableView minHeight="220" fx:id="contractsTable" HBox.hgrow="ALWAYS">
            <placeholder>
                <Label text="Договоров пока нет" styleClass="muted-text"/>
            </placeholder>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="idColumn" text="№" minWidth="50" prefWidth="55"/>
                <TableColumn fx:id="orderColumn" text="Заявка" minWidth="60" prefWidth="70"/>
                <TableColumn fx:id="counterpartyColumn" text="Контрагент" prefWidth="130"/>
                <TableColumn fx:id="forwarderColumn" text="Экспедитор" prefWidth="110"/>
                <TableColumn fx:id="priceColumn" text="Цена, руб." minWidth="100" prefWidth="115"/>
                <TableColumn fx:id="statusColumn" text="Статус" minWidth="150" prefWidth="170"/>
            </columns>
        </TableView>
        <VBox styleClass="card" prefWidth="250" minWidth="220" maxWidth="290" spacing="8">
            <Label text="Сведения о договоре" styleClass="section-title"/>
            <Label fx:id="detailsHint" text="Выберите договор в таблице" styleClass="muted-text" wrapText="true"/>
            <GridPane fx:id="detailsGrid" hgap="8" vgap="8">
                <columnConstraints>
                    <ColumnConstraints minWidth="85" prefWidth="95"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>
                <Label text="Номер" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <Label wrapText="true" fx:id="detailsNumber" styleClass="value-label" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label text="Статус" styleClass="field-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Label wrapText="true" fx:id="detailsStatus" styleClass="status-badge" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                <Label text="Заявка" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <Label wrapText="true" fx:id="detailsOrder" styleClass="value-label" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                <Label fx:id="detailsCounterpartyCaption" styleClass="field-label"
                       GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <Label fx:id="detailsCounterparty" styleClass="value-label" wrapText="true"
                       GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                <Label text="Экспедитор" styleClass="field-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <Label fx:id="detailsForwarder" styleClass="value-label" wrapText="true"
                       GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                <Label text="Цена" styleClass="field-label" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                <Label wrapText="true" fx:id="detailsPrice" styleClass="value-label" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                <Label text="Условия" styleClass="field-label" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                <Label fx:id="detailsTerms" styleClass="value-label" wrapText="true"
                       GridPane.rowIndex="6" GridPane.columnIndex="1"/>
                <Label text="Срок" styleClass="field-label" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                <Label fx:id="detailsPeriod" styleClass="value-label" wrapText="true"
                       GridPane.rowIndex="7" GridPane.columnIndex="1"/>
                <Label text="Создан" styleClass="field-label" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
                <Label wrapText="true" fx:id="detailsCreated" styleClass="value-label" GridPane.rowIndex="8" GridPane.columnIndex="1"/>
            </GridPane>
        </VBox>
    </HBox>
    <Label text="Открытые запросы на изменение и расторжение" styleClass="section-title"/>
    <FlowPane hgap="8" vgap="8" alignment="CENTER_LEFT">
        <Button fx:id="respondAcceptButton" text="Принять запрос" styleClass="button-primary"
                onAction="#onRespondAccept"/>
        <Button fx:id="respondRejectButton" text="Отклонить запрос" styleClass="button-danger"
                onAction="#onRespondReject"/>
        <Button fx:id="cancelRequestButton" text="Отозвать свой запрос" styleClass="button-secondary"
                onAction="#onCancelRequest"/>
    </FlowPane>
    <TableView fx:id="requestsTable" prefHeight="150" minHeight="110">
        <placeholder>
            <Label text="Открытых запросов нет" styleClass="muted-text"/>
        </placeholder>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="requestIdColumn" text="№" minWidth="50" prefWidth="55"/>
            <TableColumn fx:id="requestContractColumn" text="Договор" minWidth="70" prefWidth="80"/>
            <TableColumn fx:id="requestTypeColumn" text="Тип" prefWidth="110"/>
            <TableColumn fx:id="requestInitiatorColumn" text="Автор" prefWidth="110"/>
            <TableColumn fx:id="requestProposalColumn" text="Предложение" prefWidth="260"/>
            <TableColumn fx:id="requestCreatedColumn" text="Создан" prefWidth="130"/>
        </columns>
    </TableView>
</VBox>
