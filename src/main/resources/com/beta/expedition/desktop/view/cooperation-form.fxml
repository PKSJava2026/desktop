<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.beta.expedition.desktop.controller.CooperationFormController"
      spacing="10" prefWidth="460" styleClass="form-box">
    <Label text="О себе" styleClass="field-label"/>
    <TextArea fx:id="descriptionField" promptText="Опыт перевозок, регионы, условия работы"
              prefRowCount="4" wrapText="true"/>
    <Label text="Транспорт" styleClass="field-label"/>
    <TextArea fx:id="vehicleField" promptText="Тип транспорта, грузоподъёмность, количество машин"
              prefRowCount="3" wrapText="true"/>
    <Label fx:id="errorLabel" styleClass="error-text" wrapText="true"/>
</VBox>
