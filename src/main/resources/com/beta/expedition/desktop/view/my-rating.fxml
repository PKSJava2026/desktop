<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.beta.expedition.desktop.controller.MyRatingController" spacing="16">
    <Label text="Мой рейтинг" styleClass="page-title"/>
    <HBox styleClass="card" spacing="24" alignment="CENTER_LEFT">
        <VBox spacing="8">
            <Label text="Средний балл" styleClass="field-label"/>
            <Label fx:id="averageLabel" styleClass="rating-average"/>
        </VBox>
        <VBox spacing="8">
            <Label text="Оценка" styleClass="field-label"/>
            <Label fx:id="starsLabel" styleClass="rating-stars"/>
        </VBox>
        <VBox spacing="8">
            <Label text="Количество" styleClass="field-label"/>
            <Label wrapText="true" fx:id="countLabel" styleClass="value-label"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <ProgressIndicator fx:id="busyIndicator" prefWidth="22" prefHeight="22"/>
        <Button fx:id="refreshButton" text="Обновить" styleClass="button-secondary" onAction="#onRefresh"/>
    </HBox>
    <TableView minHeight="220" fx:id="ratingsTable" VBox.vgrow="ALWAYS">
        <placeholder>
            <Label text="Вас пока никто не оценил" styleClass="muted-text"/>
        </placeholder>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="orderColumn" text="Заявка" minWidth="70" prefWidth="80"/>
            <TableColumn fx:id="fromColumn" text="От кого" prefWidth="130"/>
            <TableColumn fx:id="scoreColumn" text="Оценка" prefWidth="110"/>
            <TableColumn fx:id="commentColumn" text="Комментарий" prefWidth="250"/>
            <TableColumn fx:id="dateColumn" text="Дата" prefWidth="130"/>
        </columns>
    </TableView>
</VBox>
