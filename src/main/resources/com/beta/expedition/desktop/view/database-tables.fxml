<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.beta.expedition.desktop.controller.DatabaseTablesController">
    <VBox spacing="16">
        <Label text="Таблицы базы данных" styleClass="page-title"/>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Таблица" styleClass="field-label"/>
            <ComboBox fx:id="tableCombo" prefWidth="260"/>
            <Label fx:id="countLabel" styleClass="hint"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="csvButton" text="Экспорт в CSV" styleClass="button-secondary" onAction="#onExportCsv"/>
            <Button fx:id="xlsxButton" text="Экспорт в Excel" styleClass="button-secondary" onAction="#onExportXlsx"/>
            <ProgressIndicator fx:id="busyIndicator" prefWidth="22" prefHeight="22"/>
        </HBox>
        <TableView minHeight="220" fx:id="dataTable" VBox.vgrow="ALWAYS"/>
    </VBox>
</StackPane>
