<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.beta.expedition.desktop.controller.OrderFormController"
      spacing="10" prefWidth="460" styleClass="form-box">
    <Label text="Описание груза" styleClass="field-label"/>
    <TextArea fx:id="cargoField" promptText="Что нужно перевезти" prefRowCount="3" wrapText="true"/>
    <GridPane hgap="12" vgap="6">
        <columnConstraints>
            <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
            <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
        </columnConstraints>
        <Label text="Откуда" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="originField" promptText="Город отправления" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <Label text="Куда" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <TextField fx:id="destinationField" promptText="Город назначения" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Вес, кг" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="weightField" promptText="Необязательно" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <Label text="Объём, м³" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <TextField fx:id="volumeField" promptText="Необязательно" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    </GridPane>
    <Label text="Желаемая дата" styleClass="field-label"/>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <DatePicker fx:id="desiredDatePicker" promptText="Необязательно"/>
        <Button text="Очистить" styleClass="button-link" onAction="#onClearDate"/>
    </HBox>
    <Label fx:id="errorLabel" styleClass="error-text" wrapText="true"/>
</VBox>
