<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.beta.expedition.desktop.controller.MainController" styleClass="root-pane">
    <top>
        <HBox styleClass="header" spacing="16" alignment="CENTER_LEFT">
            <Label text="Экспедиторская компания" styleClass="title"/>
        </HBox>
    </top>
    <left>
        <VBox styleClass="nav" spacing="16" prefWidth="200">
            <VBox fx:id="navBox" spacing="8" VBox.vgrow="ALWAYS"/>
            <VBox spacing="8">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label fx:id="avatarLabel" styleClass="avatar"/>
                    <VBox alignment="CENTER_LEFT">
                        <Label fx:id="userNameLabel" styleClass="user-name"/>
                        <Label fx:id="userRoleLabel" styleClass="user-role"/>
                    </VBox>
                </HBox>
                <Button text="Выйти" onAction="#onLogout" styleClass="button-header" maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contentPane" styleClass="content"/>
    </center>
</BorderPane>
